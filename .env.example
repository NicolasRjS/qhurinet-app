# Copiar como .env en la raiz del proyecto y completar los valores (.env no se sube a Git).
# Lo leen el backend en local (perfil local) y docker compose en el servidor.
# Las lineas comentadas usan el valor por defecto de application.properties.

# Base de datos y seguridad (obligatorias)
# En Docker, DB_PASSWORD tambien es la contrasena con la que se crea el contenedor postgres-db.
DB_PASSWORD=
JWT_SECRET=
#DB_USER=postgres

# URLs del frontend (CORS y enlace del correo de verificacion)
#FRONTEND_URL=http://localhost:4200
#VERIFICATION_URL=http://localhost:4200/verify-email

# Gemini: clasificacion de materiales con IA
#GEMINI_API_KEY=
#GEMINI_MODEL=gemini-3.5-flash-lite

# Correo. MAIL_MODE=log no envia el correo: escribe el token de verificacion en logs/api.log.
# Usar log mientras no haya SMTP; sin SMTP y con MAIL_MODE=smtp el registro responde 503.
#MAIL_MODE=smtp
#MAIL_FROM=
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASSWORD=

# Login con Google y Facebook (se completa junto con el front)
#GOOGLE_CLIENT_ID=
#FACEBOOK_APP_ID=
#FACEBOOK_APP_SECRET=
